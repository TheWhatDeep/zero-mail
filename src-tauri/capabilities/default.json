{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: the app's own commands (BUILD.md section 13.3) and listening to the section 3 events.",
  "windows": ["main"],
  "permissions": [
    "allow-account-list",
    "allow-account-resolve",
    "allow-account-test",
    "allow-account-add",
    "allow-account-update",
    "allow-account-remove",
    "allow-account-set-enabled",
    "allow-folder-list",
    "allow-folder-refresh",
    "allow-list-page",
    "allow-message-open",
    "allow-images-allow-once",
    "allow-images-allow-sender",
    "allow-attachment-open",
    "allow-attachment-save",
    "allow-message-save-source",
    "allow-link-open",
    "allow-log-open",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
