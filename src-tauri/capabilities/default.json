{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window and compose windows (SPEC_GAPS G63): the app's own commands (BUILD.md section 13.3) and listening to the section 3 events.",
  "windows": ["main", "compose-*"],
  "permissions": [
    "allow-account-list",
    "allow-account-resolve",
    "allow-account-test",
    "allow-account-add",
    "allow-account-update",
    "allow-account-remove",
    "allow-account-oauth-start",
    "allow-account-set-enabled",
    "allow-folder-list",
    "allow-folder-refresh",
    "allow-list-page",
    "allow-message-open",
    "allow-images-allow-once",
    "allow-images-allow-sender",
    "allow-attachment-open",
    "allow-attachment-save",
    "allow-message-save-source",
    "allow-link-open",
    "allow-log-open",
    "allow-message-set-flags",
    "allow-message-move",
    "allow-message-delete",
    "allow-message-archive",
    "allow-message-mark-all-read",
    "allow-message-undo",
    "allow-folder-create",
    "allow-folder-rename",
    "allow-folder-delete",
    "allow-folder-set-role",
    "allow-folder-set-sync",
    "allow-folder-set-watch",
    "allow-folder-extend-window",
    "allow-compose-new",
    "allow-compose-reply",
    "allow-compose-reply-all",
    "allow-compose-forward",
    "allow-draft-save",
    "allow-draft-discard",
    "allow-draft-add-attachment",
    "allow-draft-remove-attachment",
    "allow-draft-send",
    "allow-outbox-undo",
    "allow-outbox-retry",
    "allow-outbox-discard",
    "allow-outbox-list",
    "allow-identity-list",
    "allow-identity-save",
    "allow-identity-delete",
    "allow-contacts-suggest",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
